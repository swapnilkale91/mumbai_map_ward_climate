# Anthropic (Claude) — used for generation, decomposition, extraction, verification
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used only for text-embedding-3-small
OPENAI_API_KEY=sk-...

# Postgres with pgvector
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# Optional tuning
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
CLAUDE_MODEL=claude-haiku-4-5-20251001
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K=5
